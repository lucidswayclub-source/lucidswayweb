NODE_ENV=development
HOST=127.0.0.1
PORT=5174
APP_ORIGIN=http://localhost:5174
PAYOUT_THRESHOLD_PAISE=200000
DATABASE_URL=mysql://lucid:CHANGE_ME@127.0.0.1:3306/lucidsway
# TICKET_SECRET signs private QR tokens and can be set alone for free passes.
# Add all three Razorpay values together to enable paid checkout. Use Test Mode on staging.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# TICKET_SECRET=at-least-32-random-characters
# Use a separate disposable database for integration tests. Tests erase its public schema.
# TEST_DATABASE_URL=mysql://lucid:CHANGE_ME@127.0.0.1:3306/lucidsway_test
# Only for the one-time admin:create command. Never commit real credentials.
# ADMIN_EMAIL=owner@example.com
# ADMIN_NAME=Owner
# ADMIN_PASSWORD=at-least-14-characters
# One-time Hostinger initialization. Remove these three values after the first successful deployment.
# BOOTSTRAP_ADMIN_EMAIL=lucidswayclub@gmail.com
# BOOTSTRAP_ADMIN_NAME=Lucidsway Superadmin
# BOOTSTRAP_ADMIN_PASSWORD=at-least-14-characters
