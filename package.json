{
  "name": "lucidswayweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --check server/index.js && node --check server/app.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env server/scripts/create-admin.js",
    "test": "node --env-file-if-exists=.env --test server/test/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.15.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
